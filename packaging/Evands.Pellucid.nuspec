<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata minClientVersion="5.3.0">
        <id>Evands.Pellucid</id>
        <version>0.0.1</version>
        <description>Evands.Pellucid provides a flexible framework for console interactions, debug messaging, logging, and terminal commands for Crestron 4-Series and modern .NET projects. Includes the Pro command framework previously in Evands.Pellucid.Pro.
        </description>
        <authors>christopher.mcneely</authors>
        <projectUrl>https://github.com/ProfessorAire/Evands.Pellucid-Crestron</projectUrl>
        <license type="expression">MIT</license>
        <icon>images\icon.png</icon>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <releaseNotes>https://github.com/ProfessorAire/Evands.Pellucid-Crestron/releases</releaseNotes>
        <copyright>Christopher McNeely 2025</copyright>
        <tags>Crestron S#Pro Simpl# Console Logging</tags>
        <dependencies>
            <group targetFramework=".NETFramework4.7" />
            <group targetFramework="net6.0" />
            <group targetFramework="net8.0" />
        </dependencies>
    </metadata>
    <files>
        <file src="..\icon.png" target="images\" />
        <file src="..\src\Evands.Pellucid\bin\Release\netstandard2.0\Evands.Pellucid.dll" target="lib\netstandard2.0" />
        <file src="..\src\Evands.Pellucid\bin\Release\netstandard2.0\Evands.Pellucid.xml" target="lib\netstandard2.0" />
    </files>
</package>